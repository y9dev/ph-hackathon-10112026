# Copy to .env (never commit .env). Real environment variables take precedence.

# Listen address
ADDR=:8080
# SQLite database file and uploads live here
DATA_DIR=./data
# true: login screen lists demo accounts (GET /api/v1/auth/demo-users); keep false outside demos
DEMO_MODE=false
# true: seed synthetic demo data on start if the database is empty (same as --seed); ignored unless DEMO_MODE=true
SEED_DEMO=false
# true only behind a reverse proxy you control: client IP comes from X-Forwarded-For / X-Real-IP (login throttling)
TRUSTED_PROXY=false
# Per-user hourly limits (0 or unset = default; negative disables)
RATE_CREATE_PER_HOUR=20
RATE_COMMENT_PER_HOUR=60
# Extra origins allowed for POST/PATCH/DELETE (e.g. Vite dev server), comma-separated
ALLOWED_ORIGINS=http://localhost:5173
# Time zone for CSV export dates and analytics day buckets
DISPLAY_TZ=Asia/Almaty
# bcrypt cost for password hashing
BCRYPT_COST=10

# --- Telegram bot (optional). The bot, link codes and notification mirroring start ONLY when the token is set.
# Create a bot with @BotFather and paste its token here (secret: never commit .env, never log it)
TELEGRAM_BOT_TOKEN=
# Public link of the bot (https://t.me/<bot_username>); shown by the UI and used for the QR code
TELEGRAM_BOT_URL=
# Public address of this web app; used for the «Открыть» deep links in bot messages
# (Telegram rejects localhost links in buttons, so for local runs the link is added to the text)
APP_BASE_URL=http://localhost:8080
# Bot API endpoint (only change for tests / a local Bot API server)
TELEGRAM_API_BASE=https://api.telegram.org

# Usage tracker: one plain GET to a visit counter at process start; set STARTUP_PING=off to disable
STARTUP_PING=on

# Copy to .env next to docker-compose.yml (never commit .env). docker compose reads it automatically
# (optional: the stack starts without it). Full list of settings: backend/.env.example

# --- Telegram bot (optional): leave TELEGRAM_BOT_TOKEN empty to run without Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# https://t.me/<bot_username> (shown by the UI and in the QR code)
TELEGRAM_BOT_URL=
# Public address of the app, used for deep links in bot messages
APP_BASE_URL=http://localhost:8080
# Bot API endpoint, change only for tests
TELEGRAM_API_BASE=https://api.telegram.org
